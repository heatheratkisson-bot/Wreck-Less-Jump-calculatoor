{"dependencies":[],"output":[{"data":{"code":"__d(function (global, require, _$$_IMPORT_DEFAULT, _$$_IMPORT_ALL, module, exports, _dependencyMap) {\n  \"use strict\";\n\n  Object.defineProperty(exports, '__esModule', {\n    value: true\n  });\n  Object.defineProperty(exports, \"SKILL_SOURCES\", {\n    enumerable: true,\n    get: function () {\n      return SKILL_SOURCES;\n    }\n  });\n  Object.defineProperty(exports, \"SKILL_CATEGORIES\", {\n    enumerable: true,\n    get: function () {\n      return SKILL_CATEGORIES;\n    }\n  });\n  const SKILL_SOURCES = {\n    msf: {\n      title: 'Motorcycle Safety Foundation — DirtBike School training',\n      url: 'https://msf-usa.org/start-your-ride/dirtbike-school/'\n    },\n    body: {\n      title: 'MXA Speed Secrets — Body Position & Bike Handling',\n      url: 'https://motocrossactionmag.com/speed-secrets-body-position-the-art-of-bike-handling/'\n    },\n    braking: {\n      title: 'MXA Speed Secrets — Effective Braking',\n      url: 'https://motocrossactionmag.com/speed-secrets-how-to-master-effective-braking/'\n    },\n    shifting: {\n      title: 'MXA — Things to Know About Shifting',\n      url: 'https://motocrossactionmag.com/ten-things-you-need-to-know-about-about-shifting/'\n    },\n    cornering: {\n      title: 'MXA — The Fine Art of Cornering',\n      url: 'https://motocrossactionmag.com/the-fine-art-of-cornering/'\n    },\n    ruts: {\n      title: 'MXA — Mastering Deep Ruts in Motocross',\n      url: 'https://motocrossactionmag.com/ten-things-about-mastering-deep-ruts/'\n    },\n    whoops: {\n      title: 'MXA — Things to Know About Mastering Whoops',\n      url: 'https://motocrossactionmag.com/ten-things-you-need-to-know-about-mastering-whoops/'\n    },\n    starts: {\n      title: 'MXA — Things to Know About Getting the Perfect Start',\n      url: 'https://motocrossactionmag.com/ten-things-about-starts/'\n    },\n    jump: {\n      title: 'MXA — How to Jump Like Travis Baker',\n      url: 'https://motocrossactionmag.com/video-how-to-jump-like-travis-baker-its-the-landing-thats-the-hard-part/'\n    },\n    berm: {\n      title: 'MXA — James Stewart and Ryan Villopoto on Berms',\n      url: 'https://motocrossactionmag.com/see-james-stewart-blow-up-berms-ryan-villopoto-dissect-glen-helen-and-scrubs-galore/'\n    },\n    sand: {\n      title: 'MXA — Stefan Everts Training and Racing Techniques',\n      url: 'https://motocrossactionmag.com/mxa-product-test-stefan-everts-mx-training-and-racing-techniques-dvd/'\n    },\n    mud: {\n      title: 'MXA — Setting Up Suspension for Mud',\n      url: 'https://motocrossactionmag.com/bare-bones-setting-up-your-suspension-for-mud/'\n    },\n    startGrates: {\n      title: 'MXA — Starting on Metal Grates',\n      url: 'https://motocrossactionmag.com/ten-things-you-need-to-know-about-starting-on-metal-grates/'\n    }\n  };\n  const SKILL_CATEGORIES = [{\n    id: 'body-position',\n    title: 'Body Position & Balance',\n    subtitle: 'Stay balanced as the bike and terrain change',\n    icon: 'body',\n    color: '#A6D608',\n    overview: 'Rider posture is dynamic: terrain, braking, acceleration, and turning all move the bike-rider balance point. Pro-level technique is not one fixed pose; it is the ability to stay relaxed, centered, and ready to move while keeping the bike controlled.',\n    lessons: [{\n      title: 'Build a neutral base',\n      body: 'With a coach watching, practice a relaxed standing position on flat, open ground at walking pace. Keep elbows comfortably bent, knees soft, eyes up, and hands light. Let your legs absorb small movements instead of locking your arms or gripping the bars tightly.'\n    }, {\n      title: 'Move with the task',\n      body: 'The MXA body-position feature emphasizes that posture changes with terrain and forces. Treat that as a cue to make small, deliberate adjustments: stay mobile, avoid hanging far behind or crowding the bars, and ask an instructor to explain the position that fits your bike and drill.'\n    }, {\n      title: 'Try a simple feedback drill',\n      body: 'At a permitted beginner practice area, ride a short, flat loop at a pace where you can stop easily. Ask a coach or trusted observer to check your head and shoulders, relaxed grip, and foot placement. Change one thing at a time; stop if control or comfort declines.'\n    }],\n    sources: ['msf', 'body']\n  }, {\n    id: 'standing-seated',\n    title: 'Standing and Seated Transitions',\n    subtitle: 'Change riding positions smoothly and intentionally',\n    icon: 'swap-vertical',\n    color: '#82B6FF',\n    overview: 'Standing and sitting are tools, not badges of speed. Smooth transitions help a rider adapt to turns, bumps, and straights without sudden weight shifts. Track shape, bike setup, visibility, and rider skill determine when a position change is useful.',\n    lessons: [{\n      title: 'Make transitions gradual',\n      body: 'On level ground and at low speed, practice moving from a relaxed seated posture to standing while keeping your head steady and grip light. Avoid pulling on the bars to lift yourself; use legs and a controlled shift of the hips. Have an instructor check your foot position.'\n    }, {\n      title: 'Plan position before the feature',\n      body: 'Look far enough ahead to decide whether you need to sit, stand, or remain neutral before reaching a corner or rough patch. Last-second movement can disturb balance. Choose an easy section with room to slow down and repeat only when the track is clear.'\n    }, {\n      title: 'Use posture to absorb, not fight',\n      body: 'A little flex through ankles, knees, and elbows lets the suspension work while you stay connected to the bike. Do not lock your joints or hold one rigid race pose everywhere. Ask a coach to adapt the drill to your height, motorcycle, and the terrain.'\n    }],\n    sources: ['msf', 'body']\n  }, {\n    id: 'throttle-control',\n    title: 'Throttle Control',\n    subtitle: 'Practice smooth, measured power inputs',\n    icon: 'speedometer',\n    color: '#E8B86D',\n    overview: 'Throttle response varies between motorcycles and surfaces. Smooth, predictable inputs make it easier to feel traction and maintain balance; abrupt opening or closing can unsettle the chassis. There is no universal throttle recipe for every obstacle.',\n    lessons: [{\n      title: 'Learn the response of your bike',\n      body: 'With an instructor, use a flat, open practice area to explore gentle acceleration and deceleration at walking pace. Keep your wrist aligned so you can roll the grip without straining. Pay attention to how the engine responds, and stop if the bike surges or you feel tense.'\n    }, {\n      title: 'Aim for smoothness before speed',\n      body: 'Repeat short, straight passes using small, progressive changes rather than repeated stabs at the throttle. A coach can watch whether your body stays balanced and whether the rear tire remains composed. Increase complexity only after the same controlled response is repeatable.'\n    }, {\n      title: 'Avoid copying an expert’s settings',\n      body: 'Professional riders use equipment, fitness, and track conditions that may be very different from yours. Their footage can help you notice smoothness and timing, but it does not establish a safe speed or input for your motorcycle. Use the manufacturer’s setup guidance and qualified coaching.'\n    }],\n    sources: ['msf', 'body']\n  }, {\n    id: 'braking-control',\n    title: 'Braking Control',\n    subtitle: 'Develop measured braking on predictable ground',\n    icon: 'hand-left',\n    color: '#FF7A86',\n    overview: 'Motocross braking articles from MXA discuss planning braking points and adapting to the surface. For learning, the priority is controlled stopping—not racing deeper into turns. Traction, slope, and posture change quickly, so build the skill at a pace that leaves a clear margin.',\n    lessons: [{\n      title: 'Start with straight-line stops',\n      body: 'On a flat, clear area, have a qualified instructor demonstrate how to apply the controls smoothly on your specific bike. Practice from a low speed with generous run-out. Keep your eyes up, arms relaxed, and motorcycle upright; do not practice emergency stops in traffic or a crowded track.'\n    }, {\n      title: 'Notice changing traction',\n      body: 'Loose soil, wet clay, sand, ruts, and slopes all change how the brakes feel. Work on one familiar surface before progressing, and stop if the tire slides or the bike becomes unstable. Do not assume a technique from a dry track transfers to a different surface.'\n    }, {\n      title: 'Separate braking and turning as you learn',\n      body: 'A beginner drill is to slow down before a broad, easy turn, then roll through it without abrupt corrections. This builds planning and feel before adding combined inputs. Advanced braking and brake slides should be learned in person with an instructor, never from text alone.'\n    }],\n    sources: ['msf', 'braking']\n  }, {\n    id: 'shifting-clutch',\n    title: 'Shifting & Clutch Use',\n    subtitle: 'Coordinate gear changes with smooth control',\n    icon: 'settings',\n    color: '#B79CFF',\n    overview: 'Gear choice affects engine response, deceleration, and how settled the motorcycle feels. MXA’s shifting guide highlights that motorcycles differ and that rider inputs can influence chassis behavior. Start by learning your own bike’s controls and manufacturer guidance.',\n    lessons: [{\n      title: 'Practice shifts on a straight',\n      body: 'In a permitted open area, ask a coach to guide low-speed upshifts and downshifts on a straight line. Keep both feet secure except for the small movement needed to shift, and keep your eyes ahead. Avoid staring down at the gear lever while moving.'\n    }, {\n      title: 'Use the clutch deliberately',\n      body: 'Learn the clutch’s engagement point while stationary and then at walking pace with an instructor. Use small, repeatable movements rather than holding or snapping the lever without a reason. Excessive slipping can overheat and wear the clutch; follow the owner’s manual.'\n    }, {\n      title: 'Choose a gear before a feature',\n      body: 'Look ahead and plan a gear that gives predictable response before reaching a corner or rough section. Avoid hurried shifts while the bike is unsettled. Race starts and advanced clutch techniques should be practiced only with a coach, controlled space, and track rules in mind.'\n    }],\n    sources: ['msf', 'shifting']\n  }, {\n    id: 'cornering',\n    title: 'Cornering Fundamentals',\n    subtitle: 'See the turn early and build a repeatable line',\n    icon: 'navigate',\n    color: '#8BD6A7',\n    overview: 'Cornering combines vision, line choice, balance, traction, and speed selection. Professional race lines are shaped by the track and competition; a new rider should prioritize a clear view and a controlled exit rather than copying a pro’s pace or exact body position.',\n    lessons: [{\n      title: 'Walk and observe the turn',\n      body: 'Before practicing, inspect the corner from a safe place. Look for loose soil, ruts, blind exits, crossing traffic, and the safest path around it. Watch the track flow and follow venue direction; never stop on the riding line to plan your approach.'\n    }, {\n      title: 'Use vision to plan',\n      body: 'With a coach on a broad beginner turn, practice looking through the turn toward a safe exit instead of fixating on the front tire. Select a conservative line with room to correct. Keep the pace slow enough to stop before the feature if something changes.'\n    }, {\n      title: 'Keep inputs calm',\n      body: 'Learn to approach at a manageable speed and avoid abrupt throttle or brake changes while leaned over. Work on one consistent turn at a time before trying tighter lines or faster entries. MXA’s pro-rider features are useful to observe, not a substitute for coached practice.'\n    }],\n    sources: ['msf', 'cornering', 'body']\n  }, {\n    id: 'berms',\n    title: 'Berms',\n    subtitle: 'Read the bank and leave room for the exit',\n    icon: 'trending-up',\n    color: '#A6D608',\n    overview: 'A berm is a built-up bank that can support a turn, but its shape, rutting, and condition change throughout a session. MXA’s pro footage shows how differently elite riders use berms; beginners should first learn to identify a smooth, open line at low speed.',\n    lessons: [{\n      title: 'Check the berm before riding it',\n      body: 'From a safe position, look at its height, firmness, rut depth, approach, and exit visibility. Avoid a berm with a collapsing edge, hidden traffic, or people nearby. Ask the track marshal which direction is in use and whether that feature is appropriate for beginners.'\n    }, {\n      title: 'Practice a wide, easy arc',\n      body: 'With coaching, approach a low, broad berm slowly and trace a predictable path that leaves an open exit. Keep your eyes toward the exit and avoid sudden steering or throttle changes. Repeat only while the section is clear and your posture remains relaxed.'\n    }, {\n      title: 'Do not chase the fastest line',\n      body: 'A pro may use the berm face, a rut, or a high line depending on race conditions. Those lines can be steep, unpredictable, or occupied. Build confidence on simple terrain first and never stop in a berm or on the landing/exit path.'\n    }],\n    sources: ['msf', 'berm', 'cornering']\n  }, {\n    id: 'flat-turns',\n    title: 'Flat Turns',\n    subtitle: 'Manage a turn without a raised bank',\n    icon: 'return-down-forward',\n    color: '#82B6FF',\n    overview: 'A flat turn provides less physical support than a berm, so traction and balance matter. Surface moisture, loose material, and camber can make the same corner feel different lap to lap. Learn to read conditions and choose a modest line before trying to carry more speed.',\n    lessons: [{\n      title: 'Assess grip and visibility',\n      body: 'Walk or observe the corner safely. Notice dust, loose marbles, polished soil, puddles, and any off-camber slope. Identify a clear exit and a place to slow before entering. If the surface is changing or the exit is blind, select another route or wait.'\n    }, {\n      title: 'Practice smooth arcs',\n      body: 'Under instruction, use a wide flat turn at low speed and focus on looking through it, relaxed arms, and gradual steering. Avoid sudden braking or throttle snaps while leaned. Stop if the tires slide or your line carries you toward the edge.'\n    }, {\n      title: 'Build consistency before speed',\n      body: 'Repeat the same easy line and ask for feedback on where you look and when you begin turning. Change one variable at a time. Do not rely on a generic “lean more” or “give it more gas” tip; the right response depends on grip and rider level.'\n    }],\n    sources: ['msf', 'cornering', 'body']\n  }, {\n    id: 'ruts',\n    title: 'Ruts',\n    subtitle: 'Read rut depth, shape, and exit before committing',\n    icon: 'git-branch',\n    color: '#E8B86D',\n    overview: 'Ruts can guide the front wheel, but they also constrain steering and vary in depth and shape. MXA’s rut feature discusses looking ahead, smoothness, and balance, and references techniques used by experienced racers. Those advanced cues are not a reason to force a rut beyond your level.',\n    lessons: [{\n      title: 'Choose a beginner-friendly rut',\n      body: 'Observe the rut from outside the track. Look for a shallow, continuous groove with a visible exit and no crossing traffic. Avoid deep, sharp, wet, or abruptly ending ruts until an instructor has assessed them and you have developed basic balance.'\n    }, {\n      title: 'Keep your focus ahead',\n      body: 'In a coached low-speed drill, look toward the end of the groove rather than staring at the front wheel. Keep your hands relaxed and maintain a posture that allows the bike to move slightly underneath you. A coach should demonstrate foot placement for your bike and the terrain.'\n    }, {\n      title: 'Do not force the line',\n      body: 'If the rut tightens, becomes deeper, or the bike starts to deflect, do not yank the bars or make an abrupt correction. Practice choosing a safer adjacent line and stopping in a designated safe area. Avoid advanced braking or throttle techniques without in-person instruction.'\n    }],\n    sources: ['msf', 'ruts', 'body']\n  }, {\n    id: 'whoops',\n    title: 'Whoops',\n    subtitle: 'Understand repeated bumps and when to bypass them',\n    icon: 'trail-sign',\n    color: '#FF7A86',\n    overview: 'Whoops are repeated bumps with speed-sensitive behavior and high consequences for a mistake. MXA’s professional-rider coverage describes techniques for race-level sections; beginners should treat whoops as an advanced feature and learn first on small, predictable terrain with coaching.',\n    lessons: [{\n      title: 'Inspect from a safe location',\n      body: 'Observe the full section, including its entry, spacing, depth, surface, exit, and visibility. Watch how the section changes as riders pass. Ask a coach or marshal whether there is an approved beginner bypass. Never stand in or near the riding line.'\n    }, {\n      title: 'Build fundamentals elsewhere',\n      body: 'Develop standing balance, vision, and smooth control on flat ground and small rollers before attempting whoops. An instructor should select a suitable first exercise and evaluate the bike setup and rider readiness. Do not imitate a pro’s entry speed, gear, or body posture.'\n    }, {\n      title: 'Skip the section when unsure',\n      body: 'If the bumps are large, blind, crowded, deteriorating, or beyond your ability, take the bypass or sit out. Do not stop in the approach or exit. A calculator speed estimate does not determine a safe speed for whoops or any track feature.'\n    }],\n    sources: ['msf', 'whoops']\n  }, {\n    id: 'jumping-landings',\n    title: 'Jumping & Landings',\n    subtitle: 'Learn feature assessment and progression before airtime',\n    icon: 'airplane',\n    color: '#B79CFF',\n    overview: 'Jump shape, takeoff condition, speed, suspension, wind, rider position, and landing geometry all affect flight. Even professional coverage stresses how demanding landings are. This guide focuses on preparation and progression; it does not prescribe a speed or guarantee a safe jump.',\n    lessons: [{\n      title: 'Inspect the entire feature',\n      body: 'From a safe place, assess the approach, lip, sight line, landing, and run-out. Check whether other riders can enter the landing zone unseen. Follow track rules and ask a qualified coach or marshal if the feature is suitable for your experience.'\n    }, {\n      title: 'Progress from flat-ground skills',\n      body: 'Develop controlled riding, body position, and braking under instruction before using even small jumps. A coach should choose the progression and check that the landing is clear. Do not use calculator results, another rider’s pace, or video to set your speed.'\n    }, {\n      title: 'Make the safe choice to roll or bypass',\n      body: 'If you cannot see the landing, the takeoff is damaged, the track is crowded, or you feel tired or unsure, skip it. Do not stop in the approach or landing zone. Learn any in-air response from a qualified instructor in person, not by experimenting over a jump.'\n    }],\n    sources: ['msf', 'jump', 'body']\n  }, {\n    id: 'air-control',\n    title: 'Air Control',\n    subtitle: 'Understand bike pitch without guessing at corrections',\n    icon: 'move',\n    color: '#82B6FF',\n    overview: 'The bike can pitch or rotate in the air, and rider input may affect it. The safe response is highly situation-specific, so a generic throttle-versus-brake instruction can be misleading. Use professional videos as observation and seek direct coaching before attempting jumps.',\n    lessons: [{\n      title: 'Learn the concepts on the ground',\n      body: 'Ask a qualified motocross coach to explain body position, wheel rotation, and pitch while the bike is stationary or on flat ground. Do not test an unfamiliar correction in the air. Your motorcycle, jump shape, and landing situation all affect the outcome.'\n    }, {\n      title: 'Watch with a learning goal',\n      body: 'When viewing professional riders, focus on preparation, smooth posture, and consistency rather than trying to copy their mid-air inputs. Elite riders use practiced techniques and controlled tracks. Video cannot tell you whether your own speed, line, or landing is safe.'\n    }, {\n      title: 'Keep the progression supervised',\n      body: 'Only practice after a coach confirms readiness and selects an appropriate training feature. Check the landing and surrounding traffic before each pass. If the bike or track feels different, do not try an improvised correction; roll away or stop safely as instructed.'\n    }],\n    sources: ['msf', 'jump']\n  }, {\n    id: 'step-up',\n    title: 'Step-up Jumps',\n    subtitle: 'Assess an elevated landing with a coach',\n    icon: 'arrow-up-circle',\n    color: '#A6D608',\n    overview: 'A step-up landing is higher than its takeoff, which can hide the landing surface and change the required trajectory. A magazine feature or pro video may show the obstacle, but it cannot establish your readiness or a safe approach speed.',\n    lessons: [{\n      title: 'Check sight lines and landing space',\n      body: 'Observe the feature from a protected viewing point. Determine whether the landing is fully visible and whether riders can appear from another line. Ask the venue staff and a qualified coach about the intended route and beginner alternatives.'\n    }, {\n      title: 'Build a progression with an instructor',\n      body: 'Develop basic control on flat ground and smaller, familiar features first. A coach should assess the step-up, your bike, and your experience, then decide whether it belongs in your progression. Never add speed because an estimate or another rider suggests it.'\n    }, {\n      title: 'Respect the landing zone',\n      body: 'Do not gather, stop, or walk in the approach or landing zone. If the landing is obscured, occupied, or changing, skip the feature. Follow track flags and wait until the course is clear before riding.'\n    }],\n    sources: ['msf', 'jump']\n  }, {\n    id: 'step-down',\n    title: 'Step-down Jumps',\n    subtitle: 'Account for a lower landing and changing visibility',\n    icon: 'arrow-down-circle',\n    color: '#FF7A86',\n    overview: 'A step-down lands lower than the takeoff and can create a longer flight or a visually deceptive gap. The landing may be difficult to see from the approach. Treat it as an advanced feature that requires a track-specific coach assessment.',\n    lessons: [{\n      title: 'Look beyond the lip',\n      body: 'From a safe location, identify the full landing, run-out, surface, and any blind spots. Do not rely on a view from the takeoff alone. Ask the marshal about current conditions, track direction, and any restrictions on the feature.'\n    }, {\n      title: 'Do not calculate your way into it',\n      body: 'The app’s jump estimate cannot model every track condition, suspension setting, wind, rider input, or traffic conflict. It is not a launch-speed recommendation. Only a qualified instructor can assess a rider and feature in person.'\n    }, {\n      title: 'Choose a conservative alternative',\n      body: 'If the landing is not clear or you have not been coached on this kind of feature, use a marked bypass or sit it out. Never stop in the landing area, and do not follow another rider into a feature without seeing that it is clear.'\n    }],\n    sources: ['msf', 'jump']\n  }, {\n    id: 'jump-combinations',\n    title: 'Doubles & Jump Combinations',\n    subtitle: 'Recognize linked features as advanced track hazards',\n    icon: 'albums',\n    color: '#E8B86D',\n    overview: 'Doubles and linked jump combinations require judging multiple takeoffs and landings with little time to reassess. A missed or obscured landing can create immediate danger for following riders. This topic is about recognition and coaching, not instructions for clearing a gap.',\n    lessons: [{\n      title: 'Read both sides of the combination',\n      body: 'Observe the entry, each takeoff, every landing, and the next section from a safe place. Check whether riders can see one another and whether a bypass exists. Ask a coach or marshal to identify beginner-appropriate options.'\n    }, {\n      title: 'Build skills in separate steps',\n      body: 'Work with a qualified instructor on basic control and smaller individual features before considering linked obstacles. The coach should decide when and how to progress based on your ability and current track conditions. Do not infer a gap or speed from a photo.'\n    }, {\n      title: 'Never stop between features',\n      body: 'The space between jumps is not a safe place to wait or observe. If the section is crowded, unclear, or beyond your level, stay off the feature and use the designated safe route. Keep spectators and equipment away from landings.'\n    }],\n    sources: ['msf', 'jump']\n  }, {\n    id: 'starts',\n    title: 'Starts',\n    subtitle: 'Practice race starts in a designated, controlled area',\n    icon: 'flag',\n    color: '#8BD6A7',\n    overview: 'Starts combine traction, reaction, balance, clutch, and nearby riders. MXA’s start coverage discusses pro race preparation, but a start gate can be hazardous and equipment differs. Practice only where the venue permits, with supervision and no one in the launch path.',\n    lessons: [{\n      title: 'Learn the gate and rules first',\n      body: 'Ask the track staff how the gate works, where the start area ends, and when practice is allowed. Check for traction changes, ruts, and other riders. Never start in the general riding area or while people are standing ahead or alongside the motorcycle.'\n    }, {\n      title: 'Rehearse controls without racing',\n      body: 'With a coach, practice stationary setup and low-speed starts in a clear designated area. Focus on a calm posture and familiar control operation rather than the holeshot. The right gear and clutch setup vary by bike, surface, and rider.'\n    }, {\n      title: 'Leave advanced starts to coaching',\n      body: 'Holeshot devices, timing tricks, and high-traction launch techniques are equipment- and rule-dependent. Do not copy a professional’s exact setup from a video. Ask your coach and read the device and motorcycle manuals before using specialized equipment.'\n    }],\n    sources: ['msf', 'starts', 'startGrates']\n  }, {\n    id: 'hill-climbs',\n    title: 'Hill Climbs',\n    subtitle: 'Evaluate the slope, surface, and safe exit first',\n    icon: 'trending-up',\n    color: '#B79CFF',\n    overview: 'A hill can hide the top, loose rocks, drop-offs, other riders, and a safe route down. A climb that is manageable in one direction or surface condition may not be safe later. Do not attempt unknown slopes or follow a rider whose path you cannot see.',\n    lessons: [{\n      title: 'Inspect the full route before moving',\n      body: 'From a safe position, confirm the top and exit are visible, the route is permitted, and no one is descending or crossing. Check the surface for erosion, loose material, and obstacles. If you cannot inspect the whole line, choose another route.'\n    }, {\n      title: 'Build control on gentle ground',\n      body: 'Practice gradual starts and stops on mild, open slopes only under qualified instruction. Learn how your motorcycle behaves and how to turn around or stop safely before increasing difficulty. Never practice with people below the bike or in the run-out.'\n    }, {\n      title: 'Know when to turn back',\n      body: 'Do not continue if traction, visibility, fatigue, or confidence deteriorates. Avoid stopping where you may slide or block other riders; follow the venue’s guidance for the safest way to exit. If unsure, dismount only when the bike is stable and the area is safe.'\n    }],\n    sources: ['msf', 'body']\n  }, {\n    id: 'sand',\n    title: 'Sand Riding',\n    subtitle: 'Expect the surface to move and change your line',\n    icon: 'water',\n    color: '#E8B86D',\n    overview: 'Sand can rut, shift, and increase rider effort quickly. Professional-rider footage from MXA, including Stefan Everts training material, is useful for observing relaxed movement, but deep sand technique is demanding. Start with a shallow, familiar section and direct coaching.',\n    lessons: [{\n      title: 'Read depth and traffic',\n      body: 'Observe whether the sand is shallow or deep, where it has piled up, and how riders are entering and exiting. Look for hidden hard edges, rocks, and cross-traffic. Pick a short section with generous space and ask a coach if it is appropriate.'\n    }, {\n      title: 'Prioritize relaxed control',\n      body: 'In a coached beginner drill, focus on looking ahead, keeping a comfortable grip, and allowing the motorcycle to move without fighting every small wiggle. Use smooth inputs and a manageable pace. Do not chase the speed or posture seen in pro footage.'\n    }, {\n      title: 'Adjust the session, not just the technique',\n      body: 'Sand is physically demanding and can hide fatigue. Take breaks, hydrate, and stop if your arms tighten or attention fades. Tire pressure, suspension, and engine setup should follow manufacturer guidance and qualified shop advice—not a universal setting.'\n    }],\n    sources: ['msf', 'sand', 'body']\n  }, {\n    id: 'mud',\n    title: 'Mud & Wet Conditions',\n    subtitle: 'Adapt to reduced and unpredictable traction',\n    icon: 'rainy',\n    color: '#82B6FF',\n    overview: 'Mud changes grip, visibility, braking, and bike weight as it accumulates. MXA’s suspension feature shows that setup considerations are condition-specific, not a single magic adjustment. For many riders, the safest skill is deciding not to ride when conditions exceed their experience.',\n    lessons: [{\n      title: 'Inspect before entering',\n      body: 'Look for standing water, slick clay, deep ruts, hidden holes, and poor visibility. Ask the venue whether the track is open and what direction or sections are closed. Avoid unknown puddles and areas where a fallen rider could be hidden from approaching traffic.'\n    }, {\n      title: 'Keep the practice simple',\n      body: 'If the venue is open and an instructor approves, choose a low-speed, broad area and focus on smooth control with room to stop. Traction can disappear suddenly, so avoid abrupt inputs and crowded lines. Stop if the bike begins to pack with mud or feels unstable.'\n    }, {\n      title: 'Check equipment after the session',\n      body: 'Mud can add weight and interfere with brakes, controls, cooling, and visibility. Stop in a safe place and inspect the motorcycle before continuing. Follow the owner’s manual for cleaning and maintenance; ask a qualified mechanic about any concern.'\n    }],\n    sources: ['msf', 'mud']\n  }, {\n    id: 'rocky-terrain',\n    title: 'Rocky & Uneven Terrain',\n    subtitle: 'Spot loose obstacles and choose a manageable line',\n    icon: 'triangle',\n    color: '#FF7A86',\n    overview: 'Rocks can deflect wheels, damage tires, and hide sharp edges or holes. Motocross and off-road motorcycles may have very different protection and tire setups. Learn on a permitted, easy route with instruction; do not assume a motocross track setup is suitable for rocky trails.',\n    lessons: [{\n      title: 'Scan the route and escape options',\n      body: 'From a safe position, look for loose and embedded rocks, blind turns, drop-offs, and oncoming riders. Choose a line you can see through, with a safe place to stop. If the route disappears over a rise or around a bend, do not enter blindly.'\n    }, {\n      title: 'Practice low-speed balance',\n      body: 'On a legal, beginner-friendly area, ask an instructor to coach slow riding and stopping over small, predictable irregularities. Keep your eyes ahead and avoid grabbing at the controls when a tire deflects. Do not practice near cliffs, traffic, or spectators.'\n    }, {\n      title: 'Inspect tires and protection',\n      body: 'Use equipment appropriate to the motorcycle and terrain, as specified by the manufacturer or a qualified shop. Before and after riding, inspect tires, rims, controls, and protective components. Stop if anything is damaged, loose, or handling unexpectedly.'\n    }],\n    sources: ['msf', 'body']\n  }];\n});","lineCount":434,"map":{"mappings":";;;;;;EAwCAA,MAAA,CAAAC,cAAA,CAAAC,OAAA;IAAAC,UAAA;IAAAC,GAAA,WAAAA,CAAA;MAAA,OAAAC,aAAA;IAAA;EAAA;EAuDAL,MAAA,CAAAC,cAAA,CAAAC,OAAA;IAAAC,UAAA;IAAAC,GAAA,WAAAA,CAAA;MAAA,OAAAE,gBAAA;IAAA;EAAA;EAvDO,MAAMD,aAA6D,GAAG;IAC3EE,GAAG,EAAE;MACHC,KAAK,EAAE,yDAAyD;MAChEC,GAAG,EAAE;IACP,CAAC;IACDC,IAAI,EAAE;MACJF,KAAK,EAAE,mDAAmD;MAC1DC,GAAG,EAAE;IACP,CAAC;IACDE,OAAO,EAAE;MACPH,KAAK,EAAE,uCAAuC;MAC9CC,GAAG,EAAE;IACP,CAAC;IACDG,QAAQ,EAAE;MACRJ,KAAK,EAAE,qCAAqC;MAC5CC,GAAG,EAAE;IACP,CAAC;IACDI,SAAS,EAAE;MACTL,KAAK,EAAE,iCAAiC;MACxCC,GAAG,EAAE;IACP,CAAC;IACDK,IAAI,EAAE;MACJN,KAAK,EAAE,wCAAwC;MAC/CC,GAAG,EAAE;IACP,CAAC;IACDM,MAAM,EAAE;MACNP,KAAK,EAAE,6CAA6C;MACpDC,GAAG,EAAE;IACP,CAAC;IACDO,MAAM,EAAE;MACNR,KAAK,EAAE,sDAAsD;MAC7DC,GAAG,EAAE;IACP,CAAC;IACDQ,IAAI,EAAE;MACJT,KAAK,EAAE,qCAAqC;MAC5CC,GAAG,EAAE;IACP,CAAC;IACDS,IAAI,EAAE;MACJV,KAAK,EAAE,iDAAiD;MACxDC,GAAG,EAAE;IACP,CAAC;IACDU,IAAI,EAAE;MACJX,KAAK,EAAE,oDAAoD;MAC3DC,GAAG,EAAE;IACP,CAAC;IACDW,GAAG,EAAE;MACHZ,KAAK,EAAE,qCAAqC;MAC5CC,GAAG,EAAE;IACP,CAAC;IACDY,WAAW,EAAE;MACXb,KAAK,EAAE,gCAAgC;MACvCC,GAAG,EAAE;IACP;EACF,CAAC;EAEM,MAAMH,gBAAiC,GAAG,CAC/C;IACEgB,EAAE,EAAE,eAAe;IACnBd,KAAK,EAAE,yBAAyB;IAChCe,QAAQ,EAAE,8CAA8C;IACxDC,IAAI,EAAE,MAAM;IACZC,KAAK,EAAE,SAAS;IAChBC,QAAQ,EACN,2PAA2P;IAC7PC,OAAO,EAAE,CAC