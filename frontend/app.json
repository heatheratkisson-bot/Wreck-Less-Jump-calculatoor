{
  "expo": {
    "name": "Wreck-Less",
    "slug": "wreck-less-jump-calculatoor",
    "version": "1.0.0",
    "scheme": "wreckless",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.joshandheather.wrecklessjumpcalculator"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#121212"
      },
      "package": "com.joshandheather.wrecklessjumpcalculator",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "WAKE_LOCK"
      ]
    },
    "plugins": [
      [
        "./plugins/withAbiFilters",
        {
          "abiFilters": [
            "arm64-v8a"
          ]
        }
      ],
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Wreck-Less to display your jump trajectory over the camera.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Wreck-Less to use your location while using the app."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.jpg",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#121212"
        }
      ],
      "expo-web-browser",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-secure-store"
    ],
    "web": {
      "favicon": "./assets/images/favicon.png"
    }
  }
}
